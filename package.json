{
  "name": "leletiv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-safe.mjs",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:empty": "node scripts/verify-empty.mjs",
    "inference:dev": ".venv-inference/bin/python inference/server.py",
    "inference:model": ".venv-inference/bin/python inference/download_model.py",
    "inference:lung-model": ".venv-inference/bin/python inference/download_lung_model.py",
    "inference:test": ".venv-inference/bin/python -m pytest inference -q",
    "demo:images": ".venv-inference/bin/python scripts/prepare-demo-images.py",
    "advanced:setup": "PIP_CONFIG_FILE=/dev/null .venv-inference/bin/python -m pip install -r inference/requirements-advanced.txt",
    "advanced:body-model": ".venv-inference/bin/python inference/download_advanced_models.py",
    "demo:seed": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@niivue/dcm2niix": "1.3.20260724",
    "@niivue/niivue": "^0.69.0",
    "@phosphor-icons/react": "2.1.10",
    "hono": "4.13.7",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "nifti-reader-js": "0.8.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.5",
    "@cloudflare/vite-plugin": "1.54.8",
    "@types/node": "^26.5.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1",
    "miniflare": "5.20260911.0-alpha"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
